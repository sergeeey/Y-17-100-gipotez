# --- Claude Code local state (never public) ---
.claude/settings.local.json
.claude/checkpoints/
.claude/state/
# hook scratch (post_commit_nudge.json etc.) — not project memory.
# NOTE: gitignore has NO inline comments; a trailing "# ..." becomes part of the pattern (bit us once, 2026-09-06)
.claude/memory/state/
# hooks also drop scratch inside subdirs (e.g. experiments/*/.claude/state/)
**/.claude/state/
.claude/worktrees/
.claude/agent-memory-local/
.claude/scheduled_tasks.lock

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- Data caches (raw downloads are re-fetchable; keep manifests + sha256, not blobs) ---
data/raw/
experiments/*/data/
*.npy
*.npz
*.h5
*.parquet

